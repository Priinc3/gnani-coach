# services/voice environment — foundation build (Phase 01)
#
# Every value is optional: missing speech/LLM/storage credentials do NOT
# crash foundation startup. Live inference is not implemented, so provider
# readiness is reported as "unavailable" regardless of what is set here.
#
# Copy to services/voice/.env (ignored by git) only when you actually have
# values. Never commit real keys.

# Gnani speech (STT/TTS). The endpoints below are the reviewed realtime
# documentation endpoints; no other endpoint may be guessed.
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts

# Google Gemini (coaching/analysis LLM). No model id is chosen in Phase 01;
# selection happens in Phase 03 from measured evidence, so leave GEMINI_MODEL
# empty rather than guessing.
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase (identity and private history) — later phases only; no project
# exists for this build. Service-role keys must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# App-level settings.
SPEAKING_COACH_ENVIRONMENT=local
