# services/voice environment — foundation build (Phase 01)
#
# Every value is optional: missing speech/LLM/storage credentials do NOT
# crash foundation startup. Live inference is not implemented, so provider
# readiness is reported as "unavailable" regardless of what is set here.
#
# Copy to services/voice/.env (ignored by git) only when you actually have
# values. Never commit real keys.

# Gnani speech (STT/TTS). The endpoints below are the reviewed realtime
# documentation endpoints; no other endpoint may be guessed.
GNANI_API_KEY=
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts

# Google Gemini (coaching/analysis LLM). No model id is chosen in Phase 01;
# selection happens in Phase 03 from measured evidence, so leave GEMINI_MODEL
# empty rather than guessing.
GEMINI_API_KEY=
GEMINI_MODEL=

# Supabase (identity and private history) — later phases only; no project
# exists for this build. Service-role keys must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# The publishable (anon) key the Auth check sends as `apikey`; server-side.
SUPABASE_PUBLISHABLE_KEY=

# App-level settings.
SPEAKING_COACH_ENVIRONMENT=local

# The browser-origin allowlist (Phase 03 FIX-1). One list, two jobs: the
# CORS allowlist of the HTTP routes and the allowlist of the WebSocket
# handshake. A JSON array or a comma-separated list; the wildcard "*" is
# refused while the settings parse. Defaults to the local web origin only.
# SPEAKING_COACH_ALLOWED_ORIGINS=http://localhost:3000

# Phase 07 resource guards. Per process: two workers double every bound.
# Counts are checked before the handshake (address), after token verification
# (user) and at process level. See docs/operations/RUNBOOK.md §3.
# SPEAKING_COACH_MAX_CONNECTIONS_PER_ADDRESS=4
# SPEAKING_COACH_MAX_CONNECTIONS_PER_USER=2
# SPEAKING_COACH_MAX_CONNECTIONS_PER_PROCESS=10
# SPEAKING_COACH_HTTP_REQUESTS_PER_MINUTE=120
# SPEAKING_COACH_WS_HANDSHAKES_PER_MINUTE=120

# Phase 07 latency endpoint. Unset: GET /health/latency answers 404. Set:
# it requires `Authorization: Bearer <this value>` and returns numbers only
# ({"turns","p50Ms","p95Ms"}). Never put a real value in source control.
# SPEAKING_COACH_HEALTH_TOKEN=

# Phase 07 live harness (opt-in, billable, never run by the default suite).
# It uses GNANI_API_KEY, GEMINI_API_KEY and GEMINI_MODEL above and runs 30
# real turns: end-of-turn to first coach audio. See
# docs/operations/RUNBOOK.md §7.
# GNANI_LIVE_TESTS=1

# A production start refuses a loopback origin on the allowlist and a
# Supabase key with no SUPABASE_URL. Keep this `local` outside production.
# SPEAKING_COACH_ENVIRONMENT=production
