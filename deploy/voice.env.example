# Gnani Coach voice service — production environment template.
#
# Installed as /etc/gnani-coach/voice.env (mode 0640, root:ubuntu).
# NEVER commit a real value: this file is committed with empty secrets.
#
# The two provider keys may live here or in the optional
# /etc/gnani-coach/keys.env (loaded after this file, so it wins). Never put
# a key on a command line: it would leak through shell history and `ps`.
#
# After editing:
#     sudo systemctl restart gnani-voice
#     curl -fsS https://13-205-26-178.sslip.io/health

# --- Provider credentials (fill these two lines) -------------------------
GNANI_API_KEY=
GEMINI_API_KEY=

# --- Provider endpoints and model (reviewed defaults) --------------------
GNANI_STT_WS_URL=wss://api.vachana.ai/stt/v3/stream
GNANI_TTS_WS_URL=wss://api.vachana.ai/api/v1/tts
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Application ---------------------------------------------------------
SPEAKING_COACH_ENVIRONMENT=production

# Browser-origin allowlist: one list, two jobs (CORS + WebSocket handshake).
# Comma-separated, no "*", and no loopback origin in production (the
# settings parser refuses both). Phase 13 replaces this placeholder with
# the Vercel URL, e.g. https://speaking-coach.vercel.app
SPEAKING_COACH_ALLOWED_ORIGINS=https://13-205-26-178.sslip.io

# --- Storage (Phase 14: SQLite on local disk, no Supabase) ---------------
SPEAKING_COACH_STORAGE_BACKEND=sqlite
SPEAKING_COACH_DATA_DIR=/var/lib/gnani-coach

# Resource caps and health-token options keep their code defaults
# (docs/operations/RUNBOOK.md §3). Do not raise them on a 2 GB box.
