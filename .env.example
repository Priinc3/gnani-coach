# Repository-root environment example — comments only, no real values.
#
# No secrets belong in source control. Per-app examples with the full variable lists:
#   apps/web/.env.example        (browser-visible values only; nothing secret)
#   services/voice/.env.example  (server-side keys: Gnani / Gemini / Supabase)
#
# Playwright (npm run test:e2e) targets this origin for the web app.
# Defaults to http://localhost:3000 when unset.
# PLAYWRIGHT_BASE_URL=http://localhost:3000
#
# The voice service health entry point:
#   SPEAKING_COACH_SERVICE_URL  (scripts/foundation/service-health-check.mjs)
# Defaults to http://127.0.0.1:8000 when unset.
# SPEAKING_COACH_SERVICE_URL=http://127.0.0.1:8000
